---
import HomeBlindsScene from "@components/layout/HomeBlindsScene.astro";
import { Icon } from "astro-icon/components";
import { backgroundWallpaper, homeConfig } from "@/config";
import type { HomeBlindsSceneItem } from "@/types/config";

const config = homeConfig.homeBlinds;
const background = config.reveal.backgroundImage;
const isEnabled = config.enabled && Boolean(background);

/** 衔接过渡带：参考页式纯线性渐变（transparent → --page-bg），
 * 不再渲染水波纹；显隐仍跟随壁纸区的渐变开关联动 */
const gradientConfig = backgroundWallpaper.banner?.gradient?.enable;
const gradientSwitchable =
	backgroundWallpaper.banner?.gradient?.switchable ?? false;
const gradientEnabledOnDesktop =
	typeof gradientConfig === "object" ? gradientConfig.desktop : gradientConfig;
const gradientEnabledOnMobile =
	typeof gradientConfig === "object" ? gradientConfig.mobile : gradientConfig;
const gradientHeight = backgroundWallpaper.banner?.gradient?.height ?? "30vh";
const shouldRenderGradient =
	gradientEnabledOnDesktop || gradientEnabledOnMobile || gradientSwitchable;
// 过渡带高度：直接采用渐变配置的高度
const transitionHeight = gradientHeight;

// 第一层入场标题配置：时长节奏供控制器使用；标题文字已由中央圈内的
// 主页文字组（data-hero-emblem）取代
const headline = config.reveal.headline;
// 迁移自 HomeHero 的身份信息文字层（揭示层，长条到位后淡入）
const hero = config.reveal.hero;
const heroEnabled = Boolean(hero?.enabled);
const sceneItems: HomeBlindsSceneItem[] = [
	{
		...config.scenes.composite,
		image: background,
	},
	...config.scenes.items.slice(0, 4),
];
const standImages = config.scenes.standImages.slice(
	0,
	Math.min(4, Math.max(0, sceneItems.length - 1)),
);
// 终幕放大层用的图片：横向叙事的最后一幕
const finaleImage = sceneItems[sceneItems.length - 1]?.image ?? background;
// 终幕文字层配置（hero 标题/副标题/快捷控件排），字段留空不渲染对应行
const finale = config.finale;
const finaleLinks = (finale?.links ?? []).filter((l) => l.icon && l.url);
/**
 * 背景跑马灯：单格宽度固定为 CYCLE_CELL_VW，先把列表重复到「一轮 ≥ 一屏宽」，
 * 再整轮复制一份首尾相接，控制器把 xPercent 从 0 走到 -50 即为无缝左移。
 */
const CYCLE_CELL_VW = 38;
const cycleImages = config.scenes.cycleImages.filter(Boolean);
const cyclePass = Math.max(
	1,
	Math.ceil(100 / (Math.max(1, cycleImages.length) * CYCLE_CELL_VW)),
);
const cycleCells = Array.from({ length: cyclePass * 2 }).flatMap(
	() => cycleImages,
);
// 底部电池为整层共用的一块，始终停在水平中间，由控制器随横移进度逐块点亮；
// 序号与百分比不显示，数值只同步到 aria-valuenow
const sceneInitialPercent = Math.round(100 / Math.max(1, sceneItems.length));
// 电池内是一排等宽小方块（不是连续长条）。
// 取 20 块：正好被 5 幕整除，每幕点亮 4 块
const METER_BLOCK_COUNT = 20;
const meterInitialLit = Math.max(
	1,
	Math.round((sceneInitialPercent / 100) * METER_BLOCK_COUNT),
);
const meterBlocks = Array.from({ length: METER_BLOCK_COUNT });
const runtimeConfig = {
	reveal: {
		foregroundOpacity: config.reveal.foregroundOpacity,
		pointerTravel: config.reveal.pointerTravel,
		headline: {
			enterDuration: headline.enterDuration ?? 0.5,
			messageHold: headline.messageHold ?? 2.6,
			messageFlipDuration: headline.messageFlipDuration ?? 0.62,
		},
	},
	scenes: {
		scrollDistance: config.scenes.scrollDistance,
		sceneCount: sceneItems.length,
		standCount: standImages.length,
		cycleDuration: config.scenes.cycleDuration,
	},
};
---

<div
	class="home-blinds"
	id="home-blinds"
	data-home-blinds-enabled={String(isEnabled)}
	data-pagefind-ignore
>
	<div class="home-blinds__fixed-stage" data-blinds-stage aria-hidden="true">
		<img
			class="home-blinds__background"
			src={background}
			alt=""
			loading="eager"
			decoding="async"
			data-blinds-background
		/>

		<div class="home-blinds__foreground-window" data-reveal-window>
			<img
				class="home-blinds__foreground"
				src={config.reveal.foregroundImage}
				alt=""
				loading="eager"
				decoding="async"
				data-reveal-foreground
			/>
		</div>

		<!-- 入场标题：长条与标题同色，长条内缘退开时标题才「从背面」显露；
		     长条固定在两侧后往外缩放消失，退场随整个揭示层一起上滑 -->
		<div class="home-blinds__headline-window" data-headline-window>
			<div class="home-blinds-headline" data-blinds-headline>
				<span class="home-blinds-headline__ring" data-headline-ring></span>
				<span class="home-blinds-headline__core" data-headline-core>
					<span class="home-blinds-headline__core-ring"></span>
					<!-- 四向刻度整组斜 45°，故单独套一层容器：外层的 rotation 归控制器 -->
					<span class="home-blinds-headline__core-ticks">
						<span class="home-blinds-headline__core-tick" data-core-tick="top"></span>
						<span class="home-blinds-headline__core-tick" data-core-tick="right"></span>
						<span class="home-blinds-headline__core-tick" data-core-tick="bottom"></span>
						<span class="home-blinds-headline__core-tick" data-core-tick="left"></span>
					</span>
				</span>
				<span class="home-blinds-headline__axis" data-headline-axis="left"></span>
				<span class="home-blinds-headline__axis" data-headline-axis="right"></span>
				<span class="home-blinds-headline__edge" data-headline-edge="left"></span>
				<span class="home-blinds-headline__edge" data-headline-edge="right"></span>

				<div class="home-blinds-headline__stack" data-headline-stack>
					<!-- 中央圈内的主页文字：职业 / 大标题 / 徽章 / 签名（原左侧栏内容迁入），
					     由控制器随长条退开节奏整组淡入 -->
					<div class="home-blinds-hero__emblem" data-hero-emblem data-blinds-hero>
						{hero?.occupation && (
							<p class="home-blinds-hero__occupation">
								{hero.occupation}
							</p>
						)}
						{hero?.displayName && (
							<p class="home-blinds-hero__name" data-echo-text>
								{hero.displayName}
							</p>
						)}
						{hero?.bio && (
							<p class="home-blinds-hero__bio">{hero.bio}</p>
						)}
					</div>
				</div>

				<span class="home-blinds-headline__band" data-headline-band="left"></span>
				<span class="home-blinds-headline__band" data-headline-band="right"></span>
			</div>
		</div>

		<!-- 迁移自 HomeHero 的辅助文字层：右栏竖排 + 磨砂对话框保留原位，
		     中央文字已并入 headline 圈内；控制器写 data-blinds-hero-revealed 后淡入 -->
		{
			heroEnabled && hero && (
				<div class="home-blinds__hero-window" data-hero-window>
					<div class="home-blinds-hero" data-blinds-hero>
						<aside class="home-blinds-hero__right">
							{hero.pill && (
								<div class="home-blinds-hero__pill">{hero.pill}</div>
							)}
							<div class="home-blinds-hero__vertical">
								{hero.verticalTitle && (
									<span class="home-blinds-hero__v-title">
										{hero.verticalTitle}
									</span>
								)}
								{hero.verticalName && (
									<span class="home-blinds-hero__v-sub">
										{hero.verticalName}
									</span>
								)}
								{hero.verticalCreative && (
									<>
										<span class="home-blinds-hero__diamond">✦</span>
										<span class="home-blinds-hero__v-sub">
											{hero.verticalCreative}
										</span>
									</>
								)}
							</div>
							{hero.footerText && (
								<div class="home-blinds-hero__footer">
									<span class="home-blinds-hero__footer-line"></span>
									<p class="home-blinds-hero__micro">
										{hero.footerText}
									</p>
								</div>
							)}
						</aside>

						{(hero.speechChinese || hero.speechEnglish) && (
							<div class="home-blinds-hero__speech" aria-label="Character message">
								{hero.speechChinese && (
									<p class="home-blinds-hero__speech-zh">
										{hero.speechChinese}
									</p>
								)}
								{hero.speechEnglish && (
									<p class="home-blinds-hero__speech-en">
										{hero.speechEnglish}
									</p>
								)}
							</div>
						)}
					</div>
				</div>
			)
		}

		<!-- 全屏背景收缩成首幕画面的过渡层：元素恒为满屏，收缩靠 clip-path 收窗
		     加图片等比 scale；2px 边框单独一层，不参与缩放也不被 clip 裁掉 -->
		<div class="home-blinds__portal" data-scenes-portal>
			<img
				class="home-blinds__portal-image"
				src={background}
				alt=""
				decoding="async"
				data-scenes-portal-image
			/>
		</div>
		<span class="home-blinds__portal-edge" data-scenes-portal-edge></span>
	</div>

	<section class="home-blinds-reveal" data-home-blinds-reveal aria-label="影像揭示">
		<div class="home-blinds-reveal__viewport" data-reveal-viewport></div>
	</section>

	<section class="home-blinds-scenes" data-home-blinds-scenes aria-label="横向影像叙事">
		<div class="home-blinds-scenes__viewport" data-scenes-viewport>
			<!-- 背景跑马灯：与立牌同时从后方以纸牌立起的姿态入场，之后持续从右往左无缝循环 -->
			<div
				class="home-blinds-scenes__cycle"
				style={`--home-blinds-cycle-cell: ${CYCLE_CELL_VW}vw`}
				aria-hidden="true"
				data-scenes-cycle
			>
				<div class="home-blinds-scenes__cycle-track" data-scenes-cycle-track>
					{
						cycleCells.map((image) => (
							<div class="home-blinds-scenes__cycle-cell">
								<img
									class="home-blinds-scenes__cycle-image"
									src={image}
									alt=""
									loading="lazy"
									decoding="async"
								/>
							</div>
						))
					}
				</div>
			</div>

			<div class="home-blinds-scenes__track" data-scenes-track>
				{
					sceneItems.map((item, index) => (
						<HomeBlindsScene
							index={index}
							total={sceneItems.length}
							item={item}
							composite={index === 0}
						/>
					))
				}
			</div>

			<div
				class="home-blinds-scenes__meter"
				data-scenes-meter
				role="progressbar"
				aria-label="影像进度"
				aria-valuemin="0"
				aria-valuemax="100"
				aria-valuenow={sceneInitialPercent}
			>
				<span class="home-blinds-scenes__meter-track">
					<span class="home-blinds-scenes__meter-blocks" data-scenes-meter-blocks>
						{
							meterBlocks.map((_, blockIndex) => (
								<span
									class:list={[
										"home-blinds-scenes__meter-block",
										{ "is-lit": blockIndex < meterInitialLit },
									]}
									data-scenes-meter-block
								/>
							))
						}
					</span>
				</span>
				<span class="home-blinds-scenes__meter-cap" aria-hidden="true"></span>
			</div>

			<div class="home-blinds-scenes__stands" aria-hidden="true">
				{
					standImages.map((image, index) => (
						<div
							class="home-blinds-scenes__stand"
							style={`--home-blinds-stand-index: ${index}`}
							data-scene-stand
							data-stand-index={index}
						>
							<img
								class="home-blinds-scenes__stand-image"
								src={image}
								alt=""
								loading="lazy"
								decoding="async"
								data-scene-stand-image
							/>
							<span
								class="home-blinds-scenes__stand-pole"
								data-scene-stand-pole></span>
						</div>
					))
				}
			</div>
		</div>

	</section>

	<!-- 终幕放大过渡层：最后一幕从图框放大到全屏。与收缩过渡层同一套
	     clip-path + 等比 scale 的几何算法，方向相反。挂在根层级并恒为
	     position: fixed（与 fixed-stage 同款机制）：不能放进被 pin 的
	     section——pin 释放后 section 残留的 transform 会把 fixed 退化成
	     相对 section 定位，图片就会跟着滚动上移 -->
	<div class="home-blinds__finale-portal" data-finale-portal>
		<img
			class="home-blinds__finale-image"
			src={finaleImage}
			alt=""
			loading="lazy"
			decoding="async"
			data-finale-image
		/>
	</div>

	<!-- 终幕文字层：独立 fixed 层（z3，位于内容区背景之上）。「番茄主理人」
	     信息组与下方「快速带你前往」同层同速——控制器每帧实测罗盘标题位置，
	     把文字块钉在其上方半个屏处随内容一起上滑；浮现期定点渐显。
	     必须挂在根层级：被 pin 的 section 残留 transform 会让 fixed 退化 -->
	{finale && (
		<div class="home-blinds__finale-copy-layer" data-finale-copy-layer>
			<div class="home-blinds__finale-copy" data-finale-copy>
				<div class="home-blinds__finale-copy-inner">
					{finale.eyebrow && (
						<p class="home-blinds__finale-eyebrow">{finale.eyebrow}</p>
					)}
					{finale.heroTitle && (
						<h2 class="home-blinds__finale-hero-title">{finale.heroTitle}</h2>
					)}
					{finale.heroSubtitle && (
						<p class="home-blinds__finale-hero-subtitle">
							{finale.heroSubtitle}
						</p>
					)}
					{finaleLinks.length > 0 && (
						<nav class="home-blinds__finale-links" aria-label="快捷入口">
							{finaleLinks.map((link) => (
								<a
									class:list={[
										"home-blinds__finale-link",
										{ "home-blinds__finale-link--icon": !link.text },
									]}
									href={link.url}
									target={link.external ? "_blank" : undefined}
									rel={link.external ? "noreferrer noopener" : undefined}
									aria-label={link.ariaLabel ?? link.text}
									title={link.ariaLabel ?? link.text}
								>
									<Icon name={link.icon} aria-hidden="true" />
									{link.text && <span>{link.text}</span>}
								</a>
							))}
						</nav>
					)}
					{finale.copyright && (
						<p class="home-blinds__finale-copyright">{finale.copyright}</p>
					)}
				</div>
			</div>
		</div>
	)}

	<style is:global>
		/* 终幕文字层：图1 式博客信息（hero 标题 + 副标题 + 快捷控件排），
		   白玻璃控件样式移植自 shirone-fq BannerStage。
		   独立 fixed 层挂在 z3（内容区背景 z2 之上）——与「快速带你前往」
		   同层同速上滑时全程保持清晰，不会被内容区渐变背景压暗 */
		.home-blinds__finale-copy-layer {
			position: fixed;
			inset: 0;
			z-index: 3;
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			will-change: opacity, transform;
		}
		.home-blinds__finale-copy {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 2rem 1.5rem;
			pointer-events: none;
		}
		.home-blinds__finale-copy-inner {
			display: flex;
			flex-direction: column;
			align-items: center;
			color: #fff;
			text-align: center;
			text-shadow: 0 2px 12px rgba(0, 0, 0, 0.48);
		}
		.home-blinds__finale-eyebrow {
			margin: 0 0 0.9rem;
			font-size: clamp(0.8rem, 1.2vw, 0.95rem);
			font-weight: 600;
			letter-spacing: 0.18em;
			text-transform: uppercase;
		}
		.home-blinds__finale-hero-title {
			margin: 0;
			font-size: clamp(2.5rem, 6vw, 4.75rem);
			font-weight: 700;
			line-height: 1.08;
		}
		.home-blinds__finale-hero-subtitle {
			margin: 0.9rem 0 0;
			font-size: clamp(1rem, 1.6vw, 1.375rem);
			font-weight: 500;
		}
		.home-blinds__finale-links {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: center;
			gap: 0.75rem;
			margin-top: 1.4rem;
			pointer-events: auto;
		}
		.home-blinds__finale-link {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			height: 2.5rem;
			padding: 0 1.125rem;
			border-radius: 999px;
			border: 1px solid rgba(255, 255, 255, 0.45);
			background: rgba(255, 255, 255, 0.14);
			backdrop-filter: blur(8px);
			-webkit-backdrop-filter: blur(8px);
			color: #fff;
			font-size: 0.95rem;
			text-decoration: none;
			text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
			transition:
				background-color 0.15s ease,
				transform 0.15s ease;
		}
		.home-blinds__finale-link:hover {
			background: rgba(255, 255, 255, 0.28);
		}
		.home-blinds__finale-link:active {
			transform: scale(0.96);
		}
		.home-blinds__finale-link svg {
			width: 1.125rem;
			height: 1.125rem;
			flex-shrink: 0;
		}
		.home-blinds__finale-link--icon {
			width: 2.5rem;
			padding: 0;
			justify-content: center;
		}
		.home-blinds__finale-copyright {
			margin: 1.6rem 0 0;
			font-size: 0.8rem;
			letter-spacing: 0.04em;
			opacity: 0.85;
		}
		/* 终幕衔接占位：SSR 高度为 0，滚动时由控制器实测写入像素高度 */
		.home-blinds__finale-spacer {
			height: 0;
		}
		@media (max-width: 1023.98px) {
			.home-blinds__finale-hero-title {
				font-size: 2.75rem;
			}
			.home-blinds__finale-hero-subtitle {
				font-size: 1.05rem;
			}
		}
	</style>

	<!-- 影像层与内容区的衔接带：参考页式纯线性渐变（transparent → --page-bg）。
	     负 margin 上叠到终幕全屏图底缘；初始隐藏，控制器随终幕放大进度淡入 -->
	{shouldRenderGradient && (
		<div
			class="home-blinds-transition"
			data-home-blinds-transition
			style={`height: ${transitionHeight}; margin-top: -${transitionHeight};`}
			aria-hidden="true"
		>
			<div
				class:list={[
					"home-blinds-transition__gradient",
					{ hidden: !gradientEnabledOnMobile },
					{ "md:hidden": !gradientEnabledOnDesktop },
				]}
			/>
		</div>
	)}

	<script
		type="application/json"
		data-home-blinds-config
		is:inline
		set:html={JSON.stringify(runtimeConfig)}
	/>
</div>

<!-- 终幕衔接占位：把内容区压到一屏之外，让「番茄主理人」显影与停留期间
     屏幕上只有定格壁纸；高度由控制器 calibrateFinaleSpacer 实测校准
     （自动吸收衔接带、布局间距等占位差异），保证与「快速带你前往」
     相距半屏、开始同速上滑的时刻落在显影完成之后 -->
{isEnabled && finale && (
	<div
		class="home-blinds__finale-spacer"
		data-finale-spacer
		aria-hidden="true"
	></div>
)}

<script>
	import {
		bootHomeBlinds,
		teardownHomeBlinds,
	} from "@/utils/home-blinds-controller";
	import { bindHomeLayer } from "@/utils/home-lifecycle";

	// 这一层带 pin 与两条无限循环时间线，必须在 Swup 替换容器之前拆掉，
	// 否则 kill() 会落在已经脱离文档的节点上
	bindHomeLayer("blinds", { boot: bootHomeBlinds, teardown: teardownHomeBlinds });
</script>
